# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
build/
.next/
out/

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Environment — NEVER commit real .env files ───────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow .env.example and .env.local.example (templates)
!**/.env.example
!**/.env.local.example

# ─── TypeScript build artifacts ───────────────────────────────────────────────
*.tsbuildinfo

# ─── Prisma generated ─────────────────────────────────────────────────────────
prisma/*.js
prisma/*.js.map
prisma/*.d.ts

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS & Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ─── Temporary project folders (not part of source) ──────────────────────────
servicios-app/backend/Clonación
servicios-app/backend/Comprobación
servicios-app/backend/Documentos
servicios-app/backend/Ejecutando
