# ─── Database ────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://servicios:CHANGE_ME@localhost:5432/servicios_db"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ─── Seed (optional) ──────────────────────────────────────────────────────────
# Password used for all demo accounts created by prisma/seed.js
# Defaults to "Harambal2025!" when not set — override in production.
SEED_PASSWORD="REPLACE_WITH_SECURE_DEMO_PASSWORD"
# Admin account email created by the seed. Defaults to admin.harambal@gmail.com
SEED_ADMIN_EMAIL="admin.harambal@gmail.com"
