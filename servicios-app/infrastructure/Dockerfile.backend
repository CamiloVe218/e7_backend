# ── Stage 1: dependencies ────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
RUN npm ci

# ── Stage 2: build ───────────────────────────────────────────────────────────
FROM deps AS builder
WORKDIR /app

COPY . .
RUN npx prisma generate
RUN npm run build

# ── Stage 3: production deps only ────────────────────────────────────────────
FROM node:20-alpine AS prod-deps
WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
# Install production deps + keep prisma CLI (needed for migrate deploy)
RUN npm ci --omit=dev && \
    # Prisma CLI must stay for runtime migrations
    npm install --no-save prisma@$(node -e "console.log(require('./node_modules/prisma/package.json').version)" 2>/dev/null || echo "5")

# ── Stage 4: production ──────────────────────────────────────────────────────
FROM node:20-alpine AS production
ENV NODE_ENV=production
WORKDIR /app

RUN apk add --no-cache openssl

COPY --from=builder   /app/dist         ./dist
COPY --from=builder   /app/node_modules ./node_modules
COPY --from=builder   /app/prisma       ./prisma
COPY                  package.json      ./package.json

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget -qO- http://localhost:4000/api/health || exit 1

CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/main"]
